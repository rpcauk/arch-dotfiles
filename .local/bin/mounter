#!/bin/bash

# Mounts Android Phones and USB drives (encrypted or not)

phone_esc(){ echo "$@" | tr -dc '[:alnum:]\n\r' | tr '[:upper:]' '[:lower:]'; }

# PHONES
mounted_phones="$(grep "simple-mtpfs" /etc/mtab)"
phones="$(simple-mtpfs -l 2>/dev/null)"
phones="$(for phone in "$phones"; do
    [[ -z "$drive" ]] && continue
    esc_phone=$(phone_esc "$phone")
    [[ "$mounted_phones" =~ "$esc_phone" ]] && continue
    echo " $phone"
done)"

# LUKS DRIVES
all_drives="$(lsblk -n -rpo "uuid,name,size,mountpoint,fstype" | grep -v '^ .*')"

luks="$(echo "$all_drives" | grep crypto_LUKS)"
luks="$(for drive in "$luks"; do
    [[ -z "$drive" ]] && continue
    uuid=$(echo "$drive" | cut -d ' ' -f 1)
    name=$(echo "$drive" | cut -d ' ' -f 2)
    size=$(echo "$drive" | cut -d ' ' -f 3)
    sudo cryptsetup status "$uuid" | grep -q "is active" && continue
    echo " $name ($size)"
done)"

# OTHER DRIVES
drives=$(echo "$all_drives" | grep -v "crypto_LUKS" | grep "/dev/sd[b-z][0-9]\+")
drives="$(for drive in "$drives"; do
    [[ -z "$drive" ]] && continue
    uuid=$(echo "$drive" | cut -d ' ' -f 1)
    [[ -z "$drive" ]] && continue
    name=$(echo "$drive" | cut -d ' ' -f 2)
    size=$(echo "$drive" | cut -d ' ' -f 3)
    mount=$(echo "$drive" | cut -d ' ' -f 4)
    [[ -z "$mount" ]] || continue
    echo " $name ($size)"
done)"

mountable="$(echo "$phones
$luks
$drives" | sed "/^$/d")"

# Feed all found drives to dmenu and get user choice.
chosen="$(echo "$mountable" | rofi -dmenu -p "mount")"

# Function for prompting user for a mountpoint.
get_mount(){
    mp="$(find /media /mnt /home -maxdepth 1 -type d 2>/dev/null | rofi -dmenu -p "path")"
    if [ ! -d "$mp" ]; then
        mkdiryn=$(printf "no\\nyes" | rofi -dmenu -p "create?")
        [ "$mkdiryn" = "yes" ] && (mkdir -p "$mp" || sudo -A mkdir -p "$mp")
    fi
}

case "$chosen" in
    *)
        get_mount
	sudo -A mount $(echo "$chosen" | cut -d ' ' -f 2) "$mp" -o uid="$(id -u)",gid="$(id -g)"
	mount_return=$?
	if [[ $mount_return ]]; then
            notify-send "Drive Mounted Successfully" "$chosen mounted to $mp"
	else
            notify-send "Failed to Mount Drive" "$chosen could not be mounted to $mp"
	fi
    ;;
    *)
        name=$(echo "$chosen" | cut -d ' ' -f 2)
	uuid=$(echo "$all_drives" | grep "$name" | cut -d ' ' -f 1)
	rofi -dmenu -password -p "password" | sudo cryptsetup open "$name" "$uuid" -
	decrypt_return=$?
	if [[ ! $decrypt_return ]]; then
            notify-send "Failed to Decrypt Drive" "Invalid passphrase for $chosen"
	    exit 1
	fi
        # Check if now decrypted.
        test -b "/dev/mapper/${uuid}"
        get_mount
        sudo -A mount "/dev/mapper/${uuid}" "$mp" -o uid="$(id -u)",gid="$(id -g)"
	mount_return=$?
	if [[ $mount_return ]]; then
            notify-send "Decrypted Drive Mounted Successfully" "$chosen decrypted and mounted to $mp"
	else
            notify-send "Failed to Mount Drive" "$chosen could not be mounted to $mp"
	fi
    ;;
    *)
        get_mount
        sudo -A simple-mtpfs -o allow_other -o fsname="simple-mtpfs-$(phone_esc "$chosen")" --device "${chosen:2:1}" "$mp"
	mount_return=$?
	if [[ $mount_return ]]; then
            notify-send "Android Mounted Successfully" "$chosen mounted to $mp"
	else
            notify-send "Failed to Mount Android" "$chosen could not be mounted to $mp"
	fi
    ;;
esac
